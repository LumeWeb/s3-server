package components

templ EmptyState(message string, actionLabel string, actionHref string) {
	<div class="px-4 py-8 text-center">
		<svg class="mx-auto h-10 w-10 text-muted-foreground/50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
			<path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z"></path>
		</svg>
		<p class={ Cls("form-hint", "mt-3") }>{ message }</p>
		if actionLabel != "" && actionHref != "" {
			<a
				href={ templ.SafeURL(actionHref) }
				class={ Cls("mt-4 btn-primary btn-size-sm") }
			>
				{ actionLabel }
			</a>
		}
	</div>
}
