package components

// ModalOverlayOpts configures a ModalOverlay.
type ModalOverlayOpts struct {
	ShowProp   string // Alpine property controlling visibility (used for escape + click-outside)
	IsTemplate bool   // if true, wrap in <template x-if={ ShowProp }>
	ZIndex     string // z-index class (default: "z-50")
	ExtraAttrs templ.Attributes
}

// ModalOverlay renders the shared overlay div: fixed inset-0, click-outside-to-close,
// escape-to-close, focus management via x-trap, role/aria. The caller provides all card content.
//
// x-trap (from @alpinejs/focus) handles both auto-focus on open and focus trap within the dialog.
templ ModalOverlay(opts ModalOverlayOpts, content templ.Component) {
	if opts.IsTemplate {
		<template x-if={ opts.ShowProp }>
			@modalOverlayInner(opts, content)
		</template>
	} else {
		@modalOverlayInner(opts, content)
	}
}

templ modalOverlayInner(opts ModalOverlayOpts, content templ.Component) {
	<div
		class={ "fixed inset-0 bg-black/60 flex items-center justify-center " + zIndexClass(opts.ZIndex) }
		role="dialog"
		aria-modal="true"
		if _, hasClick := opts.ExtraAttrs["@click"]; !hasClick {
			@click={ "if ($event.target === $event.currentTarget) " + opts.ShowProp + " = false" }
		}
		if _, hasEsc := opts.ExtraAttrs["@keydown.escape.window"]; !hasEsc {
			@keydown.escape.window={ opts.ShowProp + " = false" }
		}
		if opts.IsTemplate {
			x-init="$nextTick(() => { const i = $el.querySelector('input'); if (i) i.focus() })"
		}
		if !opts.IsTemplate {
			if _, hasShow := opts.ExtraAttrs["x-show"]; !hasShow {
				x-show={ opts.ShowProp }
			}
			if _, hasCloak := opts.ExtraAttrs["x-cloak"]; !hasCloak {
				x-cloak
			}
			if _, hasTrap := opts.ExtraAttrs["x-trap"]; !hasTrap {
				x-trap={ opts.ShowProp }
			}
		}
		if len(opts.ExtraAttrs) > 0 {
			{ opts.ExtraAttrs... }
		}
	>
		@content
	</div>
}

func zIndexClass(z string) string {
	if z == "" {
		return "z-50"
	}
	return z
}

// ModalShellOpts configures a ModalShell (overlay + card + header).
type ModalShellOpts struct {
	ShowProp     string
	Title        string
	Subtitle     string
	SubtitleProp string // Alpine property for dynamic subtitle (x-text)
	MaxWidth     string
	IsTemplate   bool
	StickyHeader bool
	CardClass    string // extra classes on the card div
	ZIndex       string
	ExtraAttrs   templ.Attributes
}

// ModalShell renders overlay + card + header (title + subtitle + close button).
// The caller provides the body content via `content`.
templ ModalShell(opts ModalShellOpts, content templ.Component) {
	@ModalOverlay(ModalOverlayOpts{
		ShowProp:   opts.ShowProp,
		IsTemplate: opts.IsTemplate,
		ZIndex:     opts.ZIndex,
		ExtraAttrs: opts.ExtraAttrs,
	}, modalCardContent(opts, content))
}

templ modalCardContent(opts ModalShellOpts, content templ.Component) {
	<div class={ Cls("modal-content", "mx-4", maxWidth(opts.MaxWidth), opts.CardClass) }>
		<div class={ Cls("card-header", "flex", "items-center", "justify-between", stickyHeaderClass(opts.StickyHeader)) }>
			<div class="min-w-0">
				<h3 class="section-title">{ opts.Title }</h3>
				if opts.SubtitleProp != "" {
					<p class={ Cls("meta-text", "mt-0.5") } x-text={ opts.SubtitleProp }></p>
				} else if opts.Subtitle != "" {
					<p class={ Cls("meta-text", "mt-0.5") }>{ opts.Subtitle }</p>
				}
			</div>
			<button
				type="button"
				class={ Cls("modal-close", "btn-size-icon") }
				@click={ opts.ShowProp + " = false" }
			>&times;</button>
		</div>
		@content
	</div>
}

func maxWidth(w string) string {
	if w == "" {
		return "max-w-md"
	}
	return w
}

func stickyHeaderClass(sticky bool) string {
	if sticky {
		return "sticky top-0 bg-card z-10"
	}
	return ""
}

// Dialog is a reusable confirm modal driven by Alpine.js.
// The caller controls visibility via the x-data property named by `showProp`
// on the parent element. Usage:
//
//	<div x-data="{ showDelete: false }">
//	  <button @click="showDelete = true">Delete</button>
//	  @Dialog("showDelete", "Delete item", "Are you sure?", "Delete", "btn-danger")
//	</div>
templ Dialog(showProp string, title string, message string, confirmText string, confirmClass string) {
	@ModalShell(ModalShellOpts{
		ShowProp: showProp,
		Title:    title,
		ExtraAttrs: templ.Attributes{
			"x-transition": "",
		},
	}, dialogBody(showProp, message, confirmText, confirmClass))
}

templ dialogBody(showProp string, message string, confirmText string, confirmClass string) {
	<div class="p-4">
		<p class="form-hint">{ message }</p>
	</div>
	<div class="p-4 border-t border-border flex flex-col-reverse gap-2 sm:flex-row sm:justify-end sm:space-x-3">
		<button
			type="button"
			class={ Cls("btn-ghost", "btn-size-default") }
			@click={ showProp + " = false" }
		>Cancel</button>
		<button
			type="button"
			class={ Cls(confirmClass, "btn-size-default") }
			@click={ showProp + " = false; $nextTick(() => $dispatch('dialog-confirm', { source: '" + showProp + "' }))" }
		>{ confirmText }</button>
	</div>
}

// CreateDialog is a reusable create modal with a single text input form.
// The caller must provide these Alpine reactive properties on the parent x-data:
//   - {showProp}: boolean, controls visibility
//   - createName: string, bound to the text input
//   - createErr: string, shown as error if non-empty
//   - creating: boolean, drives loading state on the submit button
//   - {submitFn}(): async, called on form submit
//
// If extraContent is non-nil, it is rendered between the name input and the
// error/submit row, allowing callers to add extra fields (e.g. a dropdown).
templ CreateDialog(showProp string, title string, label string, placeholder string, hint string, pattern string, submitFn string, extraContent templ.Component) {
	@ModalShell(ModalShellOpts{
		ShowProp:   showProp,
		Title:      title,
		IsTemplate: true,
	}, createDialogBody(showProp, label, placeholder, hint, pattern, submitFn, extraContent))
}

templ createDialogBody(showProp string, label string, placeholder string, hint string, pattern string, submitFn string, extraContent templ.Component) {
	<form
		@submit.prevent={ submitFn }
		class="p-4 space-y-4"
	>
		<div>
			<label class="form-label">{ label }</label>
			<input
				type="text"
				x-model="createName"
				required
				if pattern != "" {
					pattern={ pattern }
				}
				placeholder={ placeholder }
				class="form-input"
				autocomplete="off"
			/>
			if hint != "" {
				<p class="form-hint">{ hint }</p>
			}
		</div>
		if extraContent != nil {
			@extraContent
		}
		<p x-show="createErr" x-cloak class="error-msg" x-text="createErr"></p>
		<div class="flex flex-col-reverse gap-2 sm:flex-row sm:justify-end sm:gap-3 pt-2">
			<button type="button" class={ Cls("btn-ghost", "btn-size-sm") } @click={ showProp + " = false" }>Cancel</button>
			@Button("Create", ButtonOpts{
				Type:         "submit",
				Class:        Cls("btn-primary", "btn-size-default", "whitespace-nowrap"),
				LoadingProp:  "creating",
				LoadingLabel: "Creating…",
				Disabled:     "creating",
			})
		</div>
	</form>
}

// ConfirmDialog is the global promise-based confirm dialog (replaces hx-confirm).
// Driven by web/src/confirm-dialog.ts which sets Alpine data on #confirm-dialog.
// Uses ModalOverlay directly (custom card layout with icon column, no card-header).
templ ConfirmDialog() {
	@ModalOverlay(ModalOverlayOpts{
		ShowProp: "show",
		ZIndex:   "z-[80]",
		ExtraAttrs: templ.Attributes{
			"id":                     "confirm-dialog",
			"x-data":                 "{ show: false, title: 'Confirm', message: '', detail: '', variant: 'warning', resolve: null }",
			"x-transition":           "",
			"@click":                 "if ($event.target === $event.currentTarget) { if (resolve) { resolve(false) }; show = false }",
			"@keydown.escape.window": "if (show && resolve) { resolve(false); show = false }",
			"aria-labelledby":        "confirm-dialog-title",
		},
	}, confirmDialogBody())
}

templ confirmDialogBody() {
	<div class={ Cls("modal-content", "max-w-md", "p-6", "shadow-xl") }>
		<div class="flex items-start gap-4">
			<div class="flex-shrink-0 mt-0.5">
				<svg x-show="variant === 'danger'" class="h-7 w-7 text-destructive" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
					<path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.75 1.5c0 1.164.5 2.25 1.5 3 1.5 1 3.5 1 5.25 1.5 1.75.5 3.75.5 5.25 0 1.5-.5 3.75-.5 5.25-1.5 1-.75 1.5-1.836 1.5-3 0-1.164-.5-2.25-1.5-3-1.5-1-3.5-1-5.25-1.5-1.75-.5-3.75-.5-5.25 0-1.5.5-3.75.5-5.25 1.5-1 .75-1.5 1.836-1.5 3z"></path>
				</svg>
				<svg x-show="variant === 'info'" class="h-7 w-7 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
					<path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z"></path>
				</svg>
				<svg x-show="variant !== 'danger' && variant !== 'info'" class="h-7 w-7 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
					<path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.75 1.5c0 1.164.5 2.25 1.5 3 1.5 1 3.5 1 5.25 1.5 1.75.5 3.75.5 5.25 0 1.5-.5 3.75-.5 5.25-1.5 1-.75 1.5-1.836 1.5-3 0-1.164-.5-2.25-1.5-3-1.5-1-3.5-1-5.25-1.5-1.75-.5-3.75-.5-5.25 0-1.5.5-3.75.5-5.25 1.5-1 .75-1.5 1.836-1.5 3z"></path>
				</svg>
			</div>
			<div class="flex-1 min-w-0">
				<h3 id="confirm-dialog-title" class="text-lg font-bold text-foreground font-display" x-text="title || 'Confirm'"></h3>
				<p class={ Cls("form-hint", "mt-2", "break-words") } x-text="message"></p>
				<template x-if="detail">
					<p class={ Cls("meta-text", "mt-1") } x-text="detail"></p>
				</template>
			</div>
		</div>
		<div class="mt-6 flex flex-col-reverse gap-2 sm:flex-row sm:justify-end sm:gap-2">
			<button
				type="button"
				class={ Cls("btn-ghost", "btn-size-default") }
				@click="if (resolve) { resolve(false) }; show = false"
			>Cancel</button>
			<button
				type="button"
				:class="variant === 'danger' ? 'btn-danger' : 'btn-primary'"
				class={ Cls("btn-size-default") }
				@click="if (resolve) { resolve(true) }; show = false"
				x-text="variant === 'danger' ? 'Delete' : 'Confirm'"
			></button>
		</div>
	</div>
}

// ErrorDialog is the global error dialog for API errors.
// Driven by web/src/error-dialog.ts which sets Alpine data on #error-dialog.
// Uses ModalOverlay directly (custom card layout with icon, no card-header).
templ ErrorDialog() {
	@ModalOverlay(ModalOverlayOpts{
		ShowProp: "show",
		ZIndex:   "z-[80]",
		ExtraAttrs: templ.Attributes{
			"id":              "error-dialog",
			"x-data":          "{ show: false, title: '', message: '', detail: '' }",
			"x-transition":    "",
			"@click":          "if ($event.target === $event.currentTarget) { show = false }",
			"aria-labelledby": "error-dialog-title",
		},
	}, errorDialogBody())
}

templ errorDialogBody() {
	<div class={ Cls("modal-content", "max-w-md", "p-6", "shadow-xl") }>
		<div class="flex items-start gap-4">
			<div class="flex-shrink-0 mt-0.5">
				<svg class="h-7 w-7 text-destructive" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
					<path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.75 1.5c0 1.164.5 2.25 1.5 3 1.5 1 3.5 1 5.25 1.5 1.75.5 3.75.5 5.25 0 1.5-.5 3.75-.5 5.25-1.5 1-.75 1.5-1.836 1.5-3 0-1.164-.5-2.25-1.5-3-1.5-1-3.5-1-5.25-1.5-1.75-.5-3.75-.5-5.25 0-1.5.5-3.75.5-5.25 1.5-1 .75-1.5 1.836-1.5 3z"></path>
				</svg>
			</div>
			<div class="flex-1 min-w-0">
				<h3 id="error-dialog-title" class="text-lg font-bold text-foreground font-display" x-text="title || 'Something went wrong'"></h3>
				<p class={ Cls("form-hint", "mt-2", "break-words") } x-text="message"></p>
				<template x-if="detail">
					<pre class="mt-3 text-xs text-muted-foreground bg-muted/50 rounded p-2 overflow-x-auto font-mono" x-text="detail"></pre>
				</template>
			</div>
		</div>
		<div class="mt-6 flex flex-col-reverse gap-2 sm:flex-row sm:justify-end sm:gap-2">
			<button
				type="button"
				class={ Cls("btn-primary", "btn-size-default") }
				@click="show = false"
			>Dismiss</button>
		</div>
	</div>
}

// Toggle is a switch-style checkbox driven by Alpine.js.
// `modelProp` is the Alpine property to bind (must be boolean on the parent x-data).
templ Toggle(modelProp string, label string) {
	<label class="flex items-center gap-3 cursor-pointer select-none">
		<button
			type="button"
			class="relative inline-flex h-6 w-11 shrink-0 items-center rounded-full border transition-colors"
			:class={ modelProp + " ? 'bg-primary border-primary' : 'bg-muted/50 border-muted-foreground/40'" }
			@click={ modelProp + " = !" + modelProp }
			role="switch"
			:aria-checked={ modelProp }
		>
			<span
				class="inline-block h-4 w-4 transform rounded-full bg-foreground transition-transform"
				:class={ modelProp + " ? 'translate-x-6' : 'translate-x-1'" }
			></span>
		</button>
		<span class="text-sm text-foreground font-body leading-none">{ label }</span>
	</label>
}
