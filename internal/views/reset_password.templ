package views

import "path/filepath"

templ ResetPassword(csrfToken string, enabled bool, dataDir string) {
	@Base("Reset Password", ResetPasswordContent(csrfToken, enabled, dataDir))
}

templ ResetPasswordContent(csrfToken string, enabled bool, dataDir string) {
	<div class="flex items-center justify-center min-h-screen px-4" data-reset-password>
		<div class="card w-full max-w-md p-8">
			@LogoTitle("S3", true)
			if enabled {
				<form class="space-y-4" x-data="resetPasswordForm()" @submit="submit($event)">
					<input type="hidden" name="_csrf" value={ csrfToken }/>
					<h2 class="text-lg font-semibold text-foreground font-display text-center">Reset Admin Password</h2>
					<p class="text-sm text-muted-foreground text-center">Set a new admin password for your account.</p>
					@FormRow("New Password", "new-password", "") {
						<div class="relative">
							<input :type="showPw ? 'text' : 'password'" id="new-password" x-model="newPassword" required minlength="8" autocomplete="new-password" class="form-input pr-10" placeholder="New password"/>
							<button type="button" @click="showPw = !showPw" class="absolute right-3 top-1/2 -translate-y-1/2 text-muted-foreground hover:text-primary transition-colors" aria-label="Toggle password visibility">
								<svg x-show="!showPw" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
									<path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z"></path>
									<path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
								</svg>
								<svg x-show="showPw" x-cloak class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
									<path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.243 4.243L9.88 9.88"></path>
								</svg>
							</button>
						</div>
					}
					@FormRow("Confirm Password", "confirm-password", "") {
						<div class="relative">
							<input :type="showPw ? 'text' : 'password'" id="confirm-password" x-model="confirmPassword" required minlength="8" autocomplete="new-password" class="form-input pr-10" placeholder="Confirm new password"/>
						</div>
					}
					<button type="submit" class="btn-full" :disabled="loading" :aria-busy="loading" x-text="loading ? 'Resetting...' : 'Reset Password'"></button>
				</form>
				<script>
					function resetPasswordForm() {
						return {
							loading: false,
							showPw: false,
							newPassword: '',
							confirmPassword: '',
							async submit(e) {
								e.preventDefault();
								if (this.newPassword !== this.confirmPassword) {
									window.__sseToast('Passwords do not match', 'error');
									return;
								}
								if (this.newPassword.length < 8) {
									window.__sseToast('Password must be at least 8 characters', 'error');
									return;
								}
								this.loading = true;
								try {
									const r = await fetch('/_panel/api/password/reset', {
										method: 'POST',
										headers: {
											'Content-Type': 'application/json',
											'X-CSRF-Token': document.querySelector('input[name="_csrf"]')?.value || ''
										},
										body: JSON.stringify({ new_password: this.newPassword })
									});
									if (r.ok) {
										window.__sseToast('Password reset successfully', 'success');
										setTimeout(function() { window.location.href = '/_panel/login'; }, 1500);
									} else {
										const data = await r.json().catch(function() { return {}; });
										window.__sseToast(data.message || 'Reset failed', 'error');
									}
								} catch(err) {
									window.__sseToast('Network error', 'error');
								}
								this.loading = false;
							}
						}
					}
				</script>
			} else {
				<div class="space-y-4">
					<h2 class="text-lg font-semibold text-foreground font-display text-center">Password Reset Unavailable</h2>
					<p class="text-sm text-muted-foreground text-center">
						Password reset is not currently enabled. To enable it, create a file named
						<code class="px-1 py-0.5 rounded bg-secondary text-secondary-foreground text-xs">.reset-token</code>
						in your server's data directory.
					</p>
					<div class="rounded-lg border border-border bg-secondary/50 p-4 space-y-3">
						<p class="text-xs font-semibold text-foreground flex items-center gap-1.5">
							<svg class="h-4 w-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
								<path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z"></path>
							</svg>
							Requirements
						</p>
						<ul class="text-xs text-muted-foreground space-y-2">
							<li class="flex items-start gap-2">
								<svg class="h-4 w-4 mt-0.5 text-muted-foreground/60 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
									<path stroke-linecap="round" stroke-linejoin="round" d="M5.25 14.25h13.5m-13.5 0L9 6.75m-3.75 7.5L9 18"></path>
								</svg>
								<span>Shell or file access to the server</span>
							</li>
							<li class="flex items-start gap-2">
								<svg class="h-4 w-4 mt-0.5 text-muted-foreground/60 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
									<path stroke-linecap="round" stroke-linejoin="round" d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 01-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H6.75a9.06 9.06 0 011.5.124A7.5 7.5 0 0018 3.75c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 00-1.125 1.125v3.5m7.5 7.5L9 12"></path>
								</svg>
								<span>The file must be at: <code class="text-foreground break-all px-1 py-0.5 rounded bg-secondary text-xs">{ filepath.Join(dataDir, ".reset-token") }</code></span>
							</li>
							<li class="flex items-start gap-2">
								<svg class="h-4 w-4 mt-0.5 text-muted-foreground/60 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
									<path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3m3 0h-3m0 0V9m0 3v3m-4.5 6.75h9a2.25 2.25 0 002.25-2.25v-9a2.25 2.25 0 00-2.25-2.25h-9A2.25 2.25 0 003.75 9v9A2.25 2.25 0 006 18.75z"></path>
								</svg>
								<span>The file can be empty — its existence enables reset</span>
							</li>
							<li class="flex items-start gap-2">
								<svg class="h-4 w-4 mt-0.5 text-muted-foreground/60 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
									<path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0"></path>
								</svg>
								<span>The file is deleted after a successful reset</span>
							</li>
						</ul>
					</div>
					<a href="/_panel/login" class="block text-center text-sm text-primary hover:text-primary/80 transition-colors">Back to login</a>
				</div>
			}
			<p class="text-center text-xs text-muted-foreground mt-6">
				Powered by S3 — Your Data. Your Rules.
			</p>
		</div>
	</div>
}
