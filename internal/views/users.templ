package views

import (
	"fmt"
	"go.lumeweb.com/s3-server/internal/views/components"
)

func userInitial(name string) string {
	if len(name) > 0 {
		return string(name[0])
	}
	return "?"
}

templ Users(users []UserInfo, csrfToken string) {
	@PageLayout("Users", "users", "", csrfToken, UsersContent(users, csrfToken))
}

templ UsersContent(users []UserInfo, csrfToken string) {
	<div
		class="max-w-5xl mx-auto px-4 py-6 space-y-6"
		x-data="usersApp"
		@dialog-confirm.window="$event.detail?.source === 'showDelete' && confirmDelete()"
	>
		<div class="card">
			<div class="card-header flex items-center justify-between">
				<div>
					<h2 class="section-title">Users</h2>
					<p class={ components.Cls("meta-text", "mt-0.5") }>Users own access keys and buckets. All keys under a user share access to that user's buckets. Create separate users to isolate storage between applications.</p>
				</div>
				<button
					type="button"
					class={ components.Cls("btn-primary", "btn-size-default", "whitespace-nowrap") }
					@click="showCreate = true"
				>
					+ Create User
				</button>
			</div>
			<div id="users-list" class="divide-y divide-surface-border">
				if len(users) == 0 {
					@components.EmptyState("No users configured. Create one to generate access keys.", "Create User", "/_panel/users")
				}
				for _, u := range users {
					@UserRow(u)
				}
			</div>
		</div>
		@components.CreateDialog("showCreate", "Create User", "User Name", "ops-team", "Letters and numbers only, 1 to 32 characters, lowercase.", "[a-z0-9]([a-z0-9-]{0,31})", "createUser()", nil)
		@components.Dialog("showDelete", "Delete User", "Delete this user and all associated access keys? This cannot be undone.", "Delete", "btn-danger")
	</div>
}

templ UserRow(u UserInfo) {
	<div class="px-4 py-3 flex items-center justify-between hover:bg-card/30 transition-colors" id={ "user-" + u.Name }>
		<div class="flex items-center gap-3 flex-1 min-w-0">
			<div class="h-8 w-8 rounded-full bg-border/50 flex items-center justify-center text-xs font-bold font-display text-muted-foreground">
				{ userInitial(u.Name) }
			</div>
			<div class="min-w-0">
				<div class="font-display text-sm text-foreground">{ u.Name }</div>
				<div class="font-body text-xs text-muted-foreground">
					{ components.CountWord(u.KeyCount, "access key") }
					if u.BucketCount > 0 {
						<span class="ml-2">· { components.CountWord(u.BucketCount, "bucket") }</span>
					}
					if u.CreatedAt != "" {
						<span class="ml-2">· created { u.CreatedAt }</span>
					}
				</div>
			</div>
		</div>
		<div class="ml-4 flex items-center gap-1">
			<a
				href={ templ.SafeURL("/_panel/keys?user=" + u.Name) }
				class="link-action"
			>
				Manage keys
			</a>
			if u.Name != "default" {
				<button
					type="button"
					class="link-danger"
					@click={ fmt.Sprintf("deleteName = '%s'; showDelete = true", components.JsEscape(u.Name)) }
				>
					Delete
				</button>
			}
		</div>
	</div>
}
