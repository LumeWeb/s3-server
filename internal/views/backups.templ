package views

import (
	"fmt"
	"strings"

	"go.lumeweb.com/s3-server/internal/views/components"
)

templ Backups(backups []BackupInfo, csrfToken string) {
	@PageLayout("Backups", "backups", "", csrfToken, BackupsContent(backups, csrfToken))
}

templ BackupsContent(backups []BackupInfo, csrfToken string) {
	<div class="max-w-5xl mx-auto px-4 py-6 space-y-6" x-data="backupsApp">
		<div class="card">
			<div class="card-header flex items-center justify-between">
				<div>
					<h2 class="section-title">Backups</h2>
					<p class={ components.Cls("meta-text", "mt-0.5") }>SQLite database backups stored on disk</p>
				</div>
				@components.Button("+ Backup Now", components.ButtonOpts{Type: "button", Class: components.Cls("btn-primary", "btn-size-default"), OnClick: "backupNow()", LoadingProp: "backing", LoadingLabel: "Backing up…", Disabled: "backing"})
			</div>
			<div id="backups-list" class="divide-y divide-surface-border">
				if len(backups) == 0 {
					@components.EmptyState("No backups yet. Trigger one to get started.", "Backup Now", "")
				}
				for _, b := range backups {
					@BackupRow(b)
				}
			</div>
		</div>
		<p x-show="backupErr" x-cloak class="error-msg" x-text="backupErr"></p>
	</div>
}

templ BackupRow(b BackupInfo) {
	<div class="px-4 py-3 flex items-center justify-between hover:bg-card/30 transition-colors" id={ "backup-" + strings.ReplaceAll(b.Filename, ".", "-") }>
		<div class="flex items-center gap-3 flex-1 min-w-0">
			<svg class="h-5 w-5 text-muted-foreground shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
				<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" transform="scale(0.8) translate(2,0)"></path>
			</svg>
			<div class="min-w-0">
				<div class="font-display text-sm text-foreground">{ b.Filename }</div>
				<div class="font-body text-xs text-muted-foreground">
					{ components.HumanBytes(b.Size) }
					if b.CreatedAt != "" {
						<span class="ml-2">· { b.CreatedAt }</span>
					}
				</div>
			</div>
		</div>
		<div class="ml-4 flex items-center gap-1">
			<a
				href={ templ.SafeURL(fmt.Sprintf("/_panel/api/backups/%s", b.Filename)) }
				class="link-action"
			>
				Download
			</a>
			<button
				type="button"
				class="link-danger"
				@click={ fmt.Sprintf("deleteBackup('%s')", components.JsEscape(b.Filename)) }
				:disabled={ fmt.Sprintf("deleting === '%s'", components.JsEscape(b.Filename)) }
			>
				Delete
			</button>
		</div>
	</div>
}
