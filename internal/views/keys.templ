package views

import (
	"fmt"
	"go.lumeweb.com/s3-server/internal/config"
	"go.lumeweb.com/s3-server/internal/views/components"
)

templ Keys(groups []UserKeyGroup, csrfToken string, backendRunning bool) {
	@PageLayout("Access Keys", "keys", "", csrfToken, KeysContent(groups, csrfToken, backendRunning))
}

templ KeysContent(groups []UserKeyGroup, csrfToken string, backendRunning bool) {
	<div class="max-w-5xl mx-auto px-4 py-6 space-y-6" x-data={ fmt.Sprintf("keysApp({ backendRunning: %t })", backendRunning) } @dialog-confirm.window="$event.detail?.source === 'showDelete' && confirmDelete()">
		<div class="card">
			<div class="card-header">
				<h2 class="section-title">Access Keys</h2>
				<p class={ components.Cls("meta-text", "mt-0.5") }>S3 credentials for programmatic access, grouped by user</p>
			</div>
			<div id="keys-list" class="divide-y divide-surface-border">
				@KeyList(groups, true, backendRunning)
			</div>
		</div>
		@components.Dialog("showDelete", "Delete Access Key", "Delete this access key? The key will stop working immediately.", "Delete", "btn-danger")
	</div>
}

templ KeyList(groups []UserKeyGroup, showGenerate bool, backendRunning bool) {
	for _, g := range groups {
		@UserKeySection(g, showGenerate, backendRunning)
	}
}

templ UserKeySection(g UserKeyGroup, showGenerate bool, backendRunning bool) {
	<div class="p-4 space-y-3" id={ fmt.Sprintf("user-section-%s", g.UserName) }>
		<div class="flex items-center justify-between">
			<div class="flex items-center gap-2">
				<div class="h-6 w-6 rounded-full bg-border/50 flex items-center justify-center text-[10px] font-bold font-display text-muted-foreground shrink-0">
					{ userInitial(g.UserName) }
				</div>
				<span class="text-sm font-display text-foreground">{ g.UserName }</span>
				<span class="text-xs font-body text-muted-foreground">
					{ components.CountWord(len(g.Keys), "key") }
					if g.BucketCount > 0 {
						<span class="ml-1">· { components.CountWord(g.BucketCount, "bucket") }</span>
					}
				</span>
			</div>
			if showGenerate {
				@components.Button("+ Generate Key", components.ButtonOpts{
					Type:         "button",
					Class:        components.Cls("btn-primary", "btn-size-default"),
					OnClick:      fmt.Sprintf("generateKey('%s')", components.JsEscape(g.UserName)),
					LoadingProp:  fmt.Sprintf("generating['%s']", components.JsEscape(g.UserName)),
					LoadingLabel: "Generating…",
					Disabled:     fmt.Sprintf("generating['%s'] || !backendRunning", components.JsEscape(g.UserName)),
				})
			}
		</div>
		if len(g.Keys) == 0 {
			<p class={ components.Cls("meta-text", "py-2") }>No access keys yet.</p>
		} else {
			<div class="space-y-1">
				for _, kp := range g.Keys {
					@KeyRow(kp)
				}
			</div>
		}
	</div>
}

templ KeyRow(kp config.KeyPair) {
	<div class="flex items-center justify-between gap-3 py-2 px-3 rounded hover:bg-card/30 transition-colors" id={ "key-" + kp.AccessKey }>
		<div class="min-w-0 flex-1 space-y-1">
			<div class="flex items-center gap-2">
				<span class="text-[10px] font-body text-muted-foreground shrink-0 w-20">Access Key</span>
				<code class="font-display text-sm truncate text-foreground">{ kp.AccessKey }</code>
			</div>
			<div class="flex items-center gap-2">
				<span class="text-[10px] font-body text-muted-foreground shrink-0 w-20">Secret Key</span>
				<code class="font-display text-xs text-muted-foreground truncate">{ components.MaskKey(kp.SecretKey) }</code>
			</div>
		</div>
		<div class="flex items-center gap-1 shrink-0">
			@components.CopyButton(kp.AccessKey, "ID")
			@components.CopyButton(kp.SecretKey, "Secret")
			<button
				type="button"
				class="link-danger"
				@click={ fmt.Sprintf("deleteAccessKey = '%s'; showDelete = true", components.JsEscape(kp.AccessKey)) }
			>
				Delete
			</button>
		</div>
	</div>
}
