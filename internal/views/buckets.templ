package views

import (
	"fmt"
	"go.lumeweb.com/s3-server/internal/views/components"
)

templ Buckets(buckets []BucketInfo, users []UserInfo, setups []SetupConfig, csrfToken string) {
	@PageLayout("Buckets", "buckets", "", csrfToken, BucketsContent(buckets, users, setups, csrfToken))
}

templ BucketsNotReady(csrfToken string) {
	@PageLayout("Buckets", "buckets", "", csrfToken, NotReadyContent())
}

templ NotReadyContent() {
	@components.BackendNotReady()
}

templ BucketsContent(buckets []BucketInfo, users []UserInfo, setups []SetupConfig, csrfToken string) {
	<div
		class="max-w-5xl mx-auto px-4 py-6 space-y-6"
		x-data="bucketPage"
		@dialog-confirm.window="$event.detail?.source === 'showVersioning' && confirmVersioning()"
	>
		<div class="card">
			<div class="card-header flex items-center justify-between">
				<div>
					<h2 class="section-title">Buckets</h2>
					<p class={ components.Cls("meta-text", "mt-0.5") }>Each bucket belongs to a user. The owner must have an access key before a bucket can be assigned to them.</p>
				</div>
				<div class="flex items-center gap-2">
					<button
						type="button"
						class={ components.Cls("btn-primary", "btn-size-default", "whitespace-nowrap") }
						@click="showCreate = true"
					>
						+ Create Bucket
					</button>
				</div>
			</div>
			<div id="buckets-list" class="divide-y divide-surface-border">
				if len(buckets) == 0 {
					@components.EmptyState("No buckets found. Create one to start storing objects.", "", "")
				}
				for _, b := range buckets {
					@BucketRow(b)
				}
			</div>
		</div>
		@components.CreateDialog("showCreate", "Create Bucket", "Bucket Name", "my-bucket", "S3 naming rules: lowercase, 3 to 63 chars.", "[a-z0-9][a-z0-9.-]{0,61}[a-z0-9]", "createBucket()", bucketOwnerField(users))
		@SetupGuideModal(setups)
		@LifecycleModal()
		@components.Dialog("showVersioning", "Confirm Versioning Change", "Change versioning status for this bucket?", "Confirm", "btn-primary")
	</div>
}

templ BucketRow(b BucketInfo) {
	<div class="px-4 py-3 flex items-center justify-between hover:bg-card/30 transition-colors" id={ "bucket-" + b.Name }>
		<div class="flex items-center gap-3 flex-1 min-w-0">
			<svg class="h-5 w-5 text-muted-foreground shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
				<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12.75V12A2.25 2.25 0 014.5 9.75h15A2.25 2.25 0 0121.75 12v.75m-8.69-6.44l-2.12-2.12a1.5 1.5 0 00-1.061-.44H4.5A2.25 2.25 0 002.25 6v12a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9a2.25 2.25 0 00-2.25-2.25h-5.379a1.5 1.5 0 01-1.06-.44z"></path>
			</svg>
			<div class="min-w-0">
				<div class="font-display text-sm text-foreground">{ b.Name }</div>
				<div class="font-body text-xs text-muted-foreground">
					if b.Owner != "" {
						<span class="text-foreground/60">{ b.Owner }</span>
						<span class="ml-1">·</span>
					}
					{ components.CountWord(b.ObjectCount, "object") }
					<span class="ml-2">· { components.HumanBytes(b.TotalSize) }</span>
					if b.Versioning != "" {
						<span class="ml-2">· { b.Versioning }</span>
					}
					if b.CreatedAt != "" {
						<span class="ml-2">· { b.CreatedAt }</span>
					}
				</div>
			</div>
		</div>
		<div class="ml-4 flex items-center gap-1">
			<button
				type="button"
				class="link-action"
				title="Show S3 client setup configuration for this bucket"
				@click={ fmt.Sprintf("openSetupGuide('%s')", components.JsEscape(b.Name)) }
			>
				Setup
			</button>
			<button
				type="button"
				class="link-action"
				title="Configure lifecycle rules (auto-transition or expire objects)"
				@click={ fmt.Sprintf("openLifecycle('%s')", components.JsEscape(b.Name)) }
			>
				Lifecycle
			</button>
			<button
				type="button"
				class="link-action"
				title="Enable or suspend S3 object versioning for this bucket"
				@click={ fmt.Sprintf("toggleVersioning('%s', '%s')", components.JsEscape(b.Name), components.JsEscape(b.Versioning)) }
			>
				{ components.VersioningButtonLabel(b.Versioning) }
			</button>
		</div>
	</div>
}

templ LifecycleModal() {
	@components.ModalShell(components.ModalShellOpts{
		ShowProp:     "showLifecycle",
		Title:        "Bucket Lifecycle",
		SubtitleProp: "lifecycleBucket",
		MaxWidth:     "max-w-2xl",
		IsTemplate:   true,
		StickyHeader: true,
		CardClass:    "max-h-[90vh] overflow-y-auto",
	}, lifecycleModalBody())
}

templ lifecycleModalBody() {
	<div class="p-4 space-y-4">
		<div x-show="lifecycleLoading" x-cloak class="form-hint">Loading…</div>
		<div x-show="lifecycleErr" x-cloak class="error-msg" x-text="lifecycleErr"></div>
		<template x-if="!lifecycleLoading && !lifecycleErr">
			<div class="space-y-3">
				<template x-for="(rule, i) in lifecycleRules" :key="i">
					<div class="flex flex-col sm:flex-row sm:items-end gap-2 p-3 border border-surface-border rounded-lg">
						<div class="flex-1 w-full sm:w-auto">
							<label class="form-label">Prefix</label>
							<input
								type="text"
								x-model="rule.prefix"
								placeholder="(all objects)"
								class="form-input"
								autocomplete="off"
							/>
						</div>
						<div class="w-full sm:w-32">
							<label class="form-label">Expire (days)</label>
							<input
								type="number"
								x-model.number="rule.expiration_days"
								min="1"
								required
								class="form-input"
							/>
						</div>
						<div class="w-full sm:w-28">
							<label class="form-label">Status</label>
							@components.Select("", components.SelectOpts{
								Model: "rule.status",
								Options: []components.SelectOption{
									{Value: "Enabled", Label: "Enabled"},
									{Value: "Disabled", Label: "Disabled"},
								},
							})
						</div>
						<button
							type="button"
							class="link-danger"
							@click="lifecycleRules.splice(i, 1)"
						>
							Remove
						</button>
					</div>
				</template>
				<div x-show="lifecycleRules.length === 0" class="py-4 space-y-6 text-center">
					<div class="border border-surface-border rounded-lg p-4 space-y-2 text-left max-w-md mx-auto">
						<p class="text-sm text-foreground font-medium font-body">How lifecycle rules work</p>
						<p class="meta-text">Rules automatically expire objects after a set number of days.</p>
						<div class="space-y-1.5 pt-1">
							<p class="meta-text"><span class="text-foreground font-medium">Prefix</span>: optional, limits the rule to objects with this path (e.g. <code class="text-primary">logs/</code>).</p>
							<p class="meta-text"><span class="text-foreground font-medium">Expire (days)</span>: matching objects are deleted after this many days.</p>
							<p class="meta-text"><span class="text-foreground font-medium">Status</span>: disable a rule without deleting it.</p>
						</div>
					</div>
					<p class={ components.Cls("form-hint", "pt-2") }>No lifecycle rules configured.</p>
					<button
						type="button"
						class={ components.Cls("btn-primary", "btn-size-sm") }
						@click="lifecycleRules.push({ prefix: '', expiration_days: 30, status: 'Enabled' })"
					>
						+ Add Rule
					</button>
				</div>
				<button
					x-show="lifecycleRules.length > 0"
					x-cloak
					type="button"
					class={ components.Cls("btn-ghost", "btn-size-sm", "mt-2") }
					@click="lifecycleRules.push({ prefix: '', expiration_days: 30, status: 'Enabled' })"
				>
					+ Add Rule
				</button>
			</div>
		</template>
	</div>
	<div class="p-4 border-t border-border flex items-center justify-between">
		<button
			type="button"
			class="link-danger px-3 py-2"
			@click="deleteLifecycle()"
			:disabled="lifecycleSaving"
			x-show="lifecycleRules.length > 0"
			x-cloak
		>
			Delete All
		</button>
		<div class="flex justify-end gap-3">
			<button type="button" class={ components.Cls("btn-ghost", "btn-size-sm") } @click="showLifecycle = false">Cancel</button>
			@components.Button("Save", components.ButtonOpts{Type: "button", Class: components.Cls("btn-primary", "btn-size-default"), OnClick: "saveLifecycle()", LoadingProp: "lifecycleSaving", LoadingLabel: "Saving…", Disabled: "lifecycleSaving", Extra: templ.Attributes{"x-show": "!lifecycleLoading && !lifecycleErr", "x-cloak": ""}})
		</div>
	</div>
}

templ bucketOwnerField(users []UserInfo) {
	<div>
		<label class="form-label">Owner</label>
		if len(UserSelectOptions(users)) > 0 {
			@components.Select("", components.SelectOpts{
				Model:   "createOwner",
				Options: UserSelectOptions(users),
			})
			<p class="form-hint">Only users with access keys are listed. Bucket will be owned by this user. All access keys under the owner share access.</p>
		} else {
			<p class="error-msg">No users with access keys. <a href="/keys" class="link-action">Create an access key first.</a></p>
		}
	</div>
}

templ SetupGuideModal(setups []SetupConfig) {
	@components.ModalShell(components.ModalShellOpts{
		ShowProp:     "showSetupGuide",
		Title:        "S3 Client Setup",
		SubtitleProp: "setupBucketName",
		MaxWidth:     "max-w-2xl",
	}, setupGuideBody(setups))
}

templ setupGuideBody(setups []SetupConfig) {
	<div class="p-5 space-y-5">
		for _, sc := range setups {
			<div x-show={ fmt.Sprintf("setupBucketName === '%s'", components.JsEscape(sc.BucketName)) } x-cloak>
				<div class="space-y-4">
					<div class="space-y-1.5">
						<p class="text-sm font-semibold text-foreground font-body">Endpoint</p>
						<p class="meta-text">Use this server's URL as the S3 endpoint in your client configuration.</p>
						<pre class="text-sm bg-muted rounded-lg p-4 font-mono"><code>{ sc.Endpoint }</code></pre>
						@components.CopyButton(sc.Endpoint, "endpoint")
					</div>
					<div class="space-y-1.5">
						<p class="text-sm font-semibold text-foreground font-body">Access Keys</p>
						if sc.AccessKey != "" {
							<p class="meta-text">
								Access key ID: <code class="text-xs font-mono">{ sc.AccessKey }</code>
							</p>
							<p class="meta-text">
								You'll also need the corresponding secret key. Create one on the
								<a href="/_panel/keys" class="text-primary hover:underline">Keys page</a>
								{ "if you don't have it." }
							</p>
						} else {
							<p class="meta-text">
								You need an access key and secret key pair. Create one on the
								<a href="/_panel/keys" class="text-primary hover:underline">Keys page</a>.
							</p>
						}
					</div>
					if sc.IsSubdomainMode() && !sc.HasManagedSSL() {
						<div class="rounded-lg border border-yellow-500/30 bg-yellow-500/5 p-3 space-y-1">
							<p class="text-sm font-medium text-yellow-600 dark:text-yellow-500">Subdomain routing configured without managed SSL</p>
							<p class="meta-text">S3 Domains are set but SSL mode is not "managed". Subdomain-style URLs (bucket.host) require wildcard certificates. Use path-style addressing until SSL is configured, or switch to managed SSL mode.</p>
						</div>
					}
					<div class="space-y-1.5">
						<p class="text-sm font-semibold text-foreground font-body">Client Configuration</p>
						<p class="meta-text">
							if sc.useSubdomain() {
								{ "Subdomain-style addressing is active (bucket.host). All configs below use virtual-hosted-style URLs." }
							} else {
								{ "Path-style addressing is active (host/bucket). All configs below use path-style URLs." }
							}
						</p>
						@components.CodeBlock(components.CodeBlockOpts{
							Tabs:       sc.Tabs(),
							DefaultIdx: 0,
						})
					</div>
				</div>
			</div>
		}
		<div class="flex justify-end">
			@components.Button("Done", components.ButtonOpts{Type: "button", Class: components.Cls("btn-primary", "btn-size-sm"), OnClick: "showSetupGuide = false"})
		</div>
	</div>
}
