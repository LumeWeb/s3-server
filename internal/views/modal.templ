package views

// Dialog is a reusable modal shell driven by Alpine.js.
// The caller controls visibility via the x-data property named by `showProp`
// on the parent element. Usage:
//
//	<div x-data="{ showDelete: false }">
//	  <button @click="showDelete = true">Delete</button>
//	  @Dialog("showDelete", "Delete item", "Are you sure?", "Delete", "btn-danger")
//	</div>
templ Dialog(showProp string, title string, message string, confirmText string, confirmClass string) {
	<div
		class="fixed inset-0 bg-black/60 flex items-center justify-center z-50"
		x-cloak
		x-show={ showProp }
		role="dialog"
		aria-modal="true"
		@click={ "if ($event.target === $event.currentTarget) " + showProp + " = false" }
		x-transition.opacity
	>
		<div class="card w-full max-w-md mx-4">
			<div class="card-header flex items-center justify-between">
				<h3 class="font-bold font-display text-foreground">{ title }</h3>
				<button
					type="button"
					class="modal-close"
					@click={ showProp + " = false" }
					>&times;</button>
			</div>
			<div class="p-4">
				<p class="text-sm text-muted-foreground font-body">{ message }</p>
			</div>
			<div class="p-4 border-t border-border flex justify-end space-x-3">
				<button
					type="button"
					class="btn-ghost text-sm px-4 py-2"
					@click={ showProp + " = false" }
				>Cancel</button>
				<button
					type="button"
					class={ "text-sm px-4 py-2 " + confirmClass }
					@click={ showProp + " = false; $nextTick(() => $dispatch('dialog-confirm', { source: '" + showProp + "' }))" }
				>{ confirmText }</button>
			</div>
		</div>
	</div>
}

// Toggle is a switch-style checkbox driven by Alpine.js.
// `modelProp` is the Alpine property to bind (must be boolean on the parent x-data).
templ Toggle(modelProp string, label string) {
	<label class="flex items-center gap-3 cursor-pointer select-none">
		<button
			type="button"
			class="relative inline-flex h-6 w-11 shrink-0 items-center rounded-full border transition-colors"
			:class={ modelProp + " ? 'bg-primary border-primary' : 'bg-muted/50 border-muted-foreground/40'" }
			@click={ modelProp + " = !" + modelProp }
			role="switch"
			:aria-checked={ modelProp }
		>
			<span
				class="inline-block h-4 w-4 transform rounded-full bg-foreground transition-transform"
				:class={ modelProp + " ? 'translate-x-6' : 'translate-x-1'" }
			></span>
		</button>
		<span class="text-sm text-foreground font-body leading-none">{ label }</span>
	</label>
}
