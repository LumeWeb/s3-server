package views

import "go.lumeweb.com/s3-server/internal/views/components"

templ Login(csrfToken string) {
	@Base("Login", LoginContent(csrfToken))
}

templ LoginContent(csrfToken string) {
	<div class="flex items-center justify-center min-h-screen" data-login>
		<div class="card w-full max-w-sm p-8">
			@components.LogoTitle("S3", true)
			<form method="POST" action="/_panel/login" class="space-y-4" x-data="loginForm" @submit.prevent="submit($event)">
				<input type="hidden" name="_csrf" value={ csrfToken }/>
				@components.PasswordField("Password", "password", "Admin password", "current-password", templ.Attributes{"name": "password"})
				@components.Button("Sign In", components.ButtonOpts{Type: "submit", Class: "btn-full", LoadingProp: "loading", LoadingLabel: "Signing in…", Disabled: "loading", Extra: templ.Attributes{":aria-busy": "loading"}})
			</form>
			<p class="text-center text-sm mt-4">
				<a href="/_panel/reset-password" class="text-primary hover:text-primary/80 transition-colors">Forgot password?</a>
			</p>
			@components.PoweredBy()
		</div>
	</div>
}
