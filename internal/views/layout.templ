package views

import "go.lumeweb.com/s3-server/internal/routes"

templ Base(title string, content templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } - S3</title>
			<link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
			<link rel="apple-touch-icon" href="/favicon.svg"/>
			<meta name="theme-color" content="#0d1d1c"/>
			<meta name="application-name" content="S3"/>
			<link rel="stylesheet" href="/_panel/assets/tailwind.css"/>
			<link rel="stylesheet" href="/_panel/assets/panel.css"/>
			<style>
				/* critical CSS: prevents FOUC before the linked stylesheet loads */
				[x-cloak]{display:none!important}
				html{background:#0d1d1c;color:#f8f8f8;font-family:"Poppins",ui-sans-serif,system-ui,sans-serif}
				body{margin:0;min-height:100vh}
			</style>
		</head>
		<body class="bg-background text-foreground font-body min-h-screen">
			<noscript>
				<div class="flex items-center justify-center min-h-screen p-4">
					<div class="card w-full max-w-lg p-8 text-center">
						<div class="flex items-center justify-center space-x-3 mb-6">
							<div class="h-10 w-10 text-primary">
								@Logo()
							</div>
							<h1 class="text-2xl font-bold font-display text-primary">S3</h1>
						</div>
						<div class="flex items-center justify-center mb-4">
							<svg class="h-12 w-12 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
								<path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"/>
							</svg>
						</div>
						<h2 class="step-heading">JavaScript Required</h2>
						<p class="step-desc">This panel needs JavaScript to function. Please enable JavaScript in your browser settings to continue.</p>
					</div>
				</div>
			</noscript>
			<script>
				// Promise resolved by the Vite bundle after API client is ready
				window.__apiReady = new Promise(resolve => {
					window.addEventListener('__api:ready', () => resolve());
				});
			</script>
			<script type="module" src="/_panel/assets/panel.js"></script>
			@content
			<div
				id="htmx-indicator"
				class="fixed top-0 left-0 right-0 h-0.5 bg-primary z-[60] opacity-0 transition-opacity"
				style="width: 100%; transform-origin: left;"
			></div>
			<div
				id="sse-toast"
				class="fixed bottom-4 right-4 z-[70]"
				x-data="{ show: false, msg: '', type: 'info', processing: false }"
				x-show="show"
				x-transition
				x-cloak
				role="alert"
				aria-live="assertive"
			>
				<div
					class="card px-4 py-3 max-w-sm flex items-center gap-3"
					:class="type === 'error' ? 'border-destructive/30' : 'border-primary/30'"
				>
					<template x-if="processing">
						<span class="spin h-5 w-5 shrink-0"></span>
					</template>
					<template x-if="!processing && type !== 'error'">
						<svg class="h-5 w-5 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
							<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
						</svg>
					</template>
					<template x-if="!processing && type === 'error'">
						<svg class="h-5 w-5 text-destructive shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
							<path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"/>
						</svg>
					</template>
					<span class="text-sm text-foreground font-body" x-text="msg"></span>
				</div>
			</div>
			<!-- Global confirm dialog (replaces native hx-confirm) -->
		<div
		id="confirm-dialog"
		class="fixed inset-0 z-[80] flex items-center justify-center bg-black/50"
		x-data="{ show: false, title: 'Confirm', message: '', detail: '', variant: 'warning', resolve: null }"
		x-show="show"
		x-cloak
		role="dialog"
		aria-modal="true"
		aria-labelledby="confirm-dialog-title"
		@click.self="if (resolve) { resolve(false); show = false }"
		x-transition.opacity
		@keydown.escape.window="if (show && resolve) { resolve(false); show = false }"
		>
		<div class="card w-full max-w-md p-6 shadow-xl">
			<div class="flex items-start gap-4">
				<div class="flex-shrink-0 mt-0.5">
					<svg x-show="variant === 'danger'" class="h-7 w-7 text-destructive" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
						<path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.75 1.5c0 1.164.5 2.25 1.5 3 1.5 1 3.5 1 5.25 1.5 1.75.5 3.75.5 5.25 0 1.5-.5 3.75-.5 5.25-1.5 1-.75 1.5-1.836 1.5-3 0-1.164-.5-2.25-1.5-3-1.5-1-3.5-1-5.25-1.5-1.75-.5-3.75-.5-5.25 0-1.5.5-3.75.5-5.25 1.5-1 .75-1.5 1.836-1.5 3z"/>
					</svg>
					<svg x-show="variant === 'info'" class="h-7 w-7 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
						<path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z"/>
					</svg>
					<svg x-show="variant !== 'danger' && variant !== 'info'" class="h-7 w-7 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
						<path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.75 1.5c0 1.164.5 2.25 1.5 3 1.5 1 3.5 1 5.25 1.5 1.75.5 3.75.5 5.25 0 1.5-.5 3.75-.5 5.25-1.5 1-.75 1.5-1.836 1.5-3 0-1.164-.5-2.25-1.5-3-1.5-1-3.5-1-5.25-1.5-1.75-.5-3.75-.5-5.25 0-1.5.5-3.75.5-5.25 1.5-1 .75-1.5 1.836-1.5 3z"/>
					</svg>
				</div>
				<div class="flex-1 min-w-0">
					<h3 id="confirm-dialog-title" class="text-lg font-bold text-foreground font-display" x-text="title || 'Confirm'"></h3>
					<p class="mt-2 text-sm text-muted-foreground font-body break-words" x-text="message"></p>
					<template x-if="detail">
						<p class="mt-1 text-xs text-muted-foreground font-body" x-text="detail"></p>
					</template>
				</div>
			</div>
			<div class="mt-6 flex justify-end gap-2">
				<button
					type="button"
					class="btn-ghost px-4 py-2 text-sm"
					@click="if (resolve) { resolve(false) }; show = false"
				>Cancel</button>
				<button
					type="button"
					:class="variant === 'danger' ? 'btn-danger' : 'btn-primary'"
						class="px-4 py-2 text-sm"
						@click="if (resolve) { resolve(true) }; show = false"
						x-text="variant === 'danger' ? 'Delete' : 'Confirm'"
					></button>
			</div>
		</div>
	</div>
		<!-- Critical error dialog (INTERNAL_ERROR, NOT_READY, etc.) -->
			<div
					id="error-dialog"
					class="fixed inset-0 z-[80] flex items-center justify-center bg-black/50"
					x-data="{ show: false, title: '', message: '', detail: '' }"
					x-show="show"
					x-cloak
					role="dialog"
					aria-modal="true"
					aria-labelledby="error-dialog-title"
					@click.self="show = false"
					x-transition.opacity
				>
				<div class="card w-full max-w-md p-6 shadow-xl">
					<div class="flex items-start gap-4">
						<div class="flex-shrink-0 mt-0.5">
							<svg class="h-7 w-7 text-destructive" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
								<path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.75 1.5c0 1.164.5 2.25 1.5 3 1.5 1 3.5 1 5.25 1.5 1.75.5 3.75.5 5.25 0 1.5-.5 3.75-.5 5.25-1.5 1-.75 1.5-1.836 1.5-3 0-1.164-.5-2.25-1.5-3-1.5-1-3.5-1-5.25-1.5-1.75-.5-3.75-.5-5.25 0-1.5.5-3.75.5-5.25 1.5-1 .75-1.5 1.836-1.5 3z"/>
							</svg>
						</div>
						<div class="flex-1 min-w-0">
							<h3 id="error-dialog-title" class="text-lg font-bold text-foreground font-display" x-text="title || 'Something went wrong'"></h3>
							<p class="mt-2 text-sm text-muted-foreground font-body break-words" x-text="message"></p>
							<template x-if="detail">
								<pre class="mt-3 text-xs text-muted-foreground bg-muted/50 rounded p-2 overflow-x-auto font-mono" x-text="detail"></pre>
							</template>
						</div>
					</div>
					<div class="mt-6 flex justify-end gap-2">
						<button
							type="button"
							class="btn-primary px-4 py-2 text-sm"
							@click="show = false"
						>Dismiss</button>
					</div>
				</div>
			</div>
	</body>
	</html>
}

templ Nav(activePage string, version string, csrfToken string) {
	<nav class="bg-card border-b border-border">
		<div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between">
			@LogoTitle("S3", false)
			<div class="flex items-center gap-1">
				@navLink("dashboard", activePage, routes.PanelDashboard, "Dashboard")
				<div class="nav-sep"></div>
				@navLink("users", activePage, routes.PanelUsers, "Users")
				@navLink("keys", activePage, routes.PanelKeys, "Keys")
				<div class="nav-sep"></div>
				@navLink("buckets", activePage, routes.PanelBuckets, "Buckets")
				<div class="nav-sep"></div>
				@navLink("backups", activePage, routes.PanelBackups, "Backups")
				@navLink("monitoring", activePage, routes.PanelMonitoring, "Monitoring")
				@navLink("settings", activePage, routes.PanelSettings, "Settings")
				<div class="nav-sep"></div>
				<button
					type="button"
					class="btn-ghost text-sm px-2 py-1"
					title="Force-upload all buffered objects to the Sia network and pin them. This is a system-wide operation and does not delete any data."
					@click="window.__sseAction && window.__sseAction('Flushing pending objects…', () => window.__api.post('/_panel/api/system/flush'), 'All pending objects flushed to the network')"
				>
					Flush
				</button>
				if version != "" {
					<span class="text-sm text-muted-foreground font-display">v{ version }</span>
				}
				<form method="POST" action={ templ.SafeURL(routes.PanelLogout) }>
					<input type="hidden" name="_csrf" value={ csrfToken }/>
					<button type="submit" class="btn-ghost text-sm px-2 py-1">Sign Out</button>
				</form>
			</div>
		</div>
	</nav>
}

templ navLink(id string, activePage string, href string, label string) {
	{{ cls := "text-sm transition-colors font-body px-2 py-1 rounded "
	   if activePage == id {
	     cls += "text-primary font-bold"
	   } else {
	     cls += "text-muted-foreground hover:text-primary"
	   }
	}}
	<a href={ templ.SafeURL(href) } class={ cls }>{ label }</a>
}
