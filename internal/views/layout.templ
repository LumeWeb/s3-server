package views

import (
	"go.lumeweb.com/s3-server/internal/routes"
	"go.lumeweb.com/s3-server/internal/views/components"
)

templ Base(title string, content templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } - S3</title>
			<link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
			<link rel="apple-touch-icon" href="/favicon.svg"/>
			<meta name="theme-color" content="#0d1d1c"/>
			<meta name="application-name" content="S3"/>
			<link rel="stylesheet" href={ templ.SafeURL("/_panel/assets/tailwind.css?v=" + AssetVersion) }/>
			<link rel="stylesheet" href={ templ.SafeURL("/_panel/assets/panel.css?v=" + AssetVersion) }/>
			<style>
				/* critical CSS: prevents FOUC before the linked stylesheet loads */
				[x-cloak]{display:none!important}
				html{background:#0d1d1c;color:#f8f8f8;font-family:"Poppins",ui-sans-serif,system-ui,sans-serif}
				body{margin:0;min-height:100vh}
				/* prevent footer flicker: apply flex layout before Tailwind loads */
				.page-layout{display:flex;flex-direction:column;min-height:100vh}
				.page-layout>main{flex:1 1 auto}
			</style>
		</head>
		<body class="bg-background text-foreground font-body min-h-screen">
			<noscript>
				<div class="flex items-center justify-center min-h-screen p-4">
					<div class="card w-full max-w-lg p-8 text-center">
						<div class="flex items-center justify-center space-x-3 mb-6">
							<div class="h-10 w-10 text-primary">
								@components.Logo()
							</div>
							<h1 class="text-2xl font-bold font-display text-primary">S3</h1>
						</div>
						<div class="flex items-center justify-center mb-4">
							<svg class="h-12 w-12 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
								<path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"></path>
							</svg>
						</div>
						<h2 class="step-heading">JavaScript Required</h2>
						<p class="step-desc">This panel needs JavaScript to function. Please enable JavaScript in your browser settings to continue.</p>
					</div>
				</div>
			</noscript>
			<script>
				// Promise resolved by the Vite bundle after API client is ready
				window.__apiReady = new Promise(resolve => {
					window.addEventListener('__api:ready', () => resolve());
				});
			</script>
			<script type="module" src={ templ.SafeURL("/_panel/assets/panel.js?v=" + AssetVersion) }></script>
			@content
			<div
				id="sse-toast"
				class="fixed bottom-4 right-4 z-[70]"
				x-data="{ show: false, msg: '', type: 'info', processing: false }"
				x-show="show"
				x-transition
				x-cloak
				role="alert"
				aria-live="assertive"
			>
				<div
					class="card px-4 py-3 max-w-sm flex items-center gap-3"
					:class="type === 'error' ? 'border-destructive/30' : 'border-primary/30'"
				>
					<template x-if="processing">
						<span class="spin h-5 w-5 shrink-0"></span>
					</template>
					<template x-if="!processing && type !== 'error'">
						<svg class="h-5 w-5 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
							<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
						</svg>
					</template>
					<template x-if="!processing && type === 'error'">
						<svg class="h-5 w-5 text-destructive shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
							<path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"></path>
						</svg>
					</template>
					<span class="text-sm text-foreground font-body" x-text="msg"></span>
				</div>
			</div>
			<!-- Global confirm dialog (replaces native hx-confirm) -->
			@components.ConfirmDialog()
			<!-- Critical error dialog (INTERNAL_ERROR, NOT_READY, etc.) -->
			@components.ErrorDialog()
		</body>
	</html>
}

// PageLayout wraps Base with Nav + page content + PoweredBy footer.
// Use this for all authenticated dashboard pages instead of @Base directly.
templ PageLayout(title string, activePage string, version string, csrfToken string, content templ.Component) {
	@Base(title, PageLayoutContent(activePage, version, csrfToken, content))
}

templ PageLayoutContent(activePage string, version string, csrfToken string, content templ.Component) {
	<div class="page-layout min-h-screen flex flex-col overflow-x-hidden">
		@Nav(activePage, version, csrfToken)
		<main class="flex-1">
			@content
		</main>
		<footer class="py-4 px-6 border-t border-border bg-card">
			@components.PoweredBy()
		</footer>
	</div>
}

templ Nav(activePage string, version string, csrfToken string) {
	<nav
		class="bg-card border-b border-border sticky top-0 z-40"
		x-data="navFlushApp"
		@dialog-confirm.window="
				$event.detail?.source === 'showFlush' && confirmFlush(),
				$event.detail?.source === 'showSignOut' && confirmSignOut()
			"
	>
		<div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between">
			@components.LogoTitle("S3", false)
			<!-- Desktop nav -->
			<div class="hidden md:flex items-center gap-1">
				<div class="flex items-center divide-x divide-border">
					@navLink("dashboard", activePage, routes.PanelDashboard, "Dashboard")
					@navLink("users", activePage, routes.PanelUsers, "Users")
					@navLink("keys", activePage, routes.PanelKeys, "Keys")
					@navLink("buckets", activePage, routes.PanelBuckets, "Buckets")
					@navLink("backups", activePage, routes.PanelBackups, "Backups")
					@navLink("monitoring", activePage, routes.PanelMonitoring, "Monitoring")
					@navLink("settings", activePage, routes.PanelSettings, "Settings")
				</div>
				<div class="nav-sep"></div>
				<button
					type="button"
					class={ components.Cls("btn-ghost", "btn-size-sm") }
					title="Force-upload all buffered objects to the Sia network and pin them. This is a system-wide operation and does not delete any data."
					@click="showFlush = true"
				>
					Flush
				</button>
				if version != "" {
					<span class="text-sm text-muted-foreground font-display">v{ version }</span>
				}
				<form id="logout-form" method="POST" action={ templ.SafeURL(routes.PanelLogout) } class="hidden">
					<input type="hidden" name="_csrf" value={ csrfToken }/>
				</form>
				<button
					type="button"
					class={ components.Cls("btn-ghost", "btn-size-sm") }
					@click="showSignOut = true"
				>Sign Out</button>
			</div>
			<!-- Mobile hamburger -->
			<button
				type="button"
				class="md:hidden touch-target"
				@click="navOpen = !navOpen"
				aria-label="Toggle navigation menu"
			>
				<svg x-show="!navOpen" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
					<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
				</svg>
				<svg x-show="navOpen" x-cloak class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
					<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
				</svg>
			</button>
		</div>
		<!-- Mobile drawer (Sheet pattern) -->
		<div>
			<!-- Backdrop -->
			<div
				x-show="navOpen"
				x-cloak
				x-transition:enter="transition ease-in-out duration-200"
				x-transition:enter-start="opacity-0"
				x-transition:enter-end="opacity-100"
				x-transition:leave="transition ease-in-out duration-200"
				x-transition:leave-start="opacity-100"
				x-transition:leave-end="opacity-0"
				class="fixed inset-0 bg-black/50 z-40 md:hidden"
				@click="navOpen = false"
			></div>
			<!-- Panel -->
			<div
				x-show="navOpen"
				x-cloak
				x-transition:enter="transition ease-in-out duration-300"
				x-transition:enter-start="translate-x-full"
				x-transition:enter-end="translate-x-0"
				x-transition:leave="transition ease-in-out duration-300"
				x-transition:leave-start="translate-x-0"
				x-transition:leave-end="translate-x-full"
				class="fixed inset-y-0 right-0 z-50 w-3/4 max-w-sm bg-card border-l border-border shadow-xl md:hidden overflow-y-auto"
			>
				<div class="p-4 flex flex-col gap-1">
					<div class="flex items-center justify-between mb-2 pb-2 border-b border-border">
						@components.LogoTitle("S3", false)
						<button type="button" class="modal-close touch-target" @click="navOpen = false" aria-label="Close menu">
							<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
								<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
							</svg>
						</button>
					</div>
					@navLinkMobile("dashboard", activePage, routes.PanelDashboard, "Dashboard", "navOpen")
					@navLinkMobile("users", activePage, routes.PanelUsers, "Users", "navOpen")
					@navLinkMobile("keys", activePage, routes.PanelKeys, "Keys", "navOpen")
					@navLinkMobile("buckets", activePage, routes.PanelBuckets, "Buckets", "navOpen")
					@navLinkMobile("backups", activePage, routes.PanelBackups, "Backups", "navOpen")
					@navLinkMobile("monitoring", activePage, routes.PanelMonitoring, "Monitoring", "navOpen")
					@navLinkMobile("settings", activePage, routes.PanelSettings, "Settings", "navOpen")
					<div class="border-t border-border mt-2 pt-2 flex flex-col gap-1">
						<button
							type="button"
							class={ components.Cls("btn-ghost", "btn-size-default", "w-full", "justify-start") }
							@click="navOpen = false; showFlush = true"
						>
							Flush
						</button>
						if version != "" {
							<span class="meta-text text-center pt-2">v{ version }</span>
						}
						<button
							type="button"
							class={ components.Cls("btn-ghost", "btn-size-default", "w-full", "justify-start") }
							@click="navOpen = false; showSignOut = true"
						>Sign Out</button>
					</div>
				</div>
			</div>
		</div>
		@components.Dialog("showFlush", "Flush Pending Objects", "This will force-upload all buffered objects to the Sia network and pin them. This is a system-wide operation and does not delete any data.", "Flush", "btn-primary")
		@components.Dialog("showSignOut", "Sign Out", "Are you sure you want to sign out? You will need to log in again to access the panel.", "Sign Out", "btn-danger")
	</nav>
}

templ navLink(id string, activePage string, href string, label string) {
	{{
		cls := components.Cls("text-sm transition-colors font-medium font-body px-2 py-1 rounded min-h-9 inline-flex items-center")
		if activePage == id {
			cls = components.Cls(cls, "text-primary bg-primary/10")
		} else {
			cls = components.Cls(cls, "text-muted-foreground hover:text-primary hover:bg-card/50")
		}
	}}
	<a href={ templ.SafeURL(href) } class={ cls }>{ label }</a>
}

templ navLinkMobile(id string, activePage string, href string, label string, closeProp string) {
	{{
		cls := components.Cls("text-sm transition-colors font-medium font-body px-3 py-2.5 rounded min-h-11 flex items-center w-full")
		if activePage == id {
			cls = components.Cls(cls, "text-primary bg-primary/10")
		} else {
			cls = components.Cls(cls, "text-muted-foreground hover:text-primary hover:bg-card/50")
		}
	}}
	<a href={ templ.SafeURL(href) } class={ cls } @click={ closeProp + " = false" }>{ label }</a>
}
