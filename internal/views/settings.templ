package views

import (
	"go.lumeweb.com/s3-server/internal/config"
	"go.lumeweb.com/s3-server/internal/updater"
	"strings"

	"go.lumeweb.com/s3-server/internal/views/components"
)

templ Settings(csrfToken string, s3Cfg config.S3Config, sslCfg config.SSLConfig, logCfg config.LogConfig, updateStatus updater.UpdateStatus, platformName string, panelVersion string, s3dVersion string) {
	@PageLayout("Settings", "settings", "", csrfToken, SettingsContent(csrfToken, s3Cfg, sslCfg, logCfg, updateStatus, platformName, panelVersion, s3dVersion))
}

func joinHostBases(bases []string) string {
	return strings.Join(bases, ", ")
}

func buildIndexerList(current string, available []config.IndexerOption) []string {
	result := make([]string, 0, len(available)+1)
	result = append(result, current)
	for _, idx := range available {
		if idx.URL != current {
			result = append(result, idx.URL)
		}
	}
	return result
}

templ SettingsContent(csrfToken string, s3Cfg config.S3Config, sslCfg config.SSLConfig, logCfg config.LogConfig, updateStatus updater.UpdateStatus, platformName string, panelVersion string, s3dVersion string) {
	<data id="settings-data" class="hidden">
		{ templ.JSONString(map[string]any{
			"s3": map[string]any{
				"directory":          s3Cfg.Directory,
				"indexer_url":        s3Cfg.IndexerURL,
				"available_indexers": buildIndexerList(s3Cfg.IndexerURL, s3Cfg.AvailableIndexers),
				"indexer_selection":  s3Cfg.IndexerURL,
				"custom_indexer":     "",
				"host_bases_input":   joinHostBases(s3Cfg.HostBases),
				"disk_usage_limit":   s3Cfg.DiskUsageLimit,
			"upload_waste_pct":   s3Cfg.UploadWastePct,
			},
			"ssl": map[string]any{
				"mode":         sslCfg.Mode,
				"acme_email":   sslCfg.ACMEEmail,
				"acme_dir_url": sslCfg.ACMEDirURL,
			},
			"log": map[string]any{
				"level":  logCfg.Level,
				"format": logCfg.Format,
			},
			"update": map[string]any{
				"sidecar_mode":   updateStatus.SidecarMode,
				"auto_update_on": updateStatus.AutoUpdateOn,
				"last_digest":    updateStatus.LastDigest,
				"updater_log":    updateStatus.UpdaterLog,
			},
		}) }
	</data>
	<div class="max-w-3xl mx-auto px-4 py-6 space-y-6" x-data="settingsApp">
		@components.CardSection("S3 Configuration") {
			<form @submit.prevent="saveS3Config()" class="p-4 space-y-4">
				@components.InputField(components.InputFieldOpts{
					Label:       "Data Directory",
					ID:          "s3-directory",
					Model:       "s3.directory",
					Placeholder: "Enter data directory path",
					Extra:       templ.Attributes{"required": true},
				})
				@components.FormRow("Indexer", "s3-indexer", "Cannot be changed after initial setup. Changing the indexer requires migrating existing data.") {
					@components.DynamicSelect(components.DynamicSelectOpts{
						Model:      "s3.indexer_selection",
						ItemsExpr:  "s3.available_indexers",
						ModelValue: s3Cfg.IndexerURL,
						Class:      "form-select opacity-60 cursor-not-allowed",
						Extra:      templ.Attributes{"id": "s3-indexer", "disabled": true},
					})
				}
				@components.InputField(components.InputFieldOpts{
					Label:       "Host Bases",
					ID:          "s3-hostbases",
					Hint:        "Comma-separated domains for virtual-hosted-style S3 URLs",
					Model:       "s3.host_bases_input",
					Placeholder: "s3.example.com, storage.example.org",
				})
				@components.InputField(components.InputFieldOpts{
					Label:       "Disk Usage Limit (GB)",
					ID:          "s3-disk-limit",
					Hint:        "Maximum storage in GB. Leave 0 for unlimited.",
					Model:       "s3.disk_usage_limit",
					Type:        "number",
					Placeholder: "0",
					Extra:       templ.Attributes{"min": "0", "step": "1"},
				})
				@components.InputField(components.InputFieldOpts{
					Label:       "Upload Waste %",
					ID:          "s3-upload-waste",
					Hint:        "Max wasted space per slab before uploading. 0.1 = 10%. Lower = faster uploads, more waste. Higher = slower uploads, less waste.",
					Model:       "s3.upload_waste_pct",
					Type:        "number",
					Placeholder: "0.1",
					Extra:       templ.Attributes{"min": "0", "max": "1", "step": "0.01"},
				})
				@components.SaveButton("s3Saving")
				<div
					class="border-t border-border pt-4 flex items-center justify-between"
					x-data="flushAllApp"
					@dialog-confirm.window="$event.detail?.source === 'showFlush' && confirmFlush()"
				>
					<div>
						<div class="text-sm text-foreground font-body">Flush all buckets</div>
						<div class="meta-text">Upload all pending objects immediately.</div>
					</div>
					@components.Button("Flush All", components.ButtonOpts{Type: "button", Class: components.Cls("btn-primary", "btn-size-default"), OnClick: "showFlush = true", LoadingProp: "flushing", LoadingLabel: "Flushing…", Disabled: "flushing"})
					@components.Dialog("showFlush", "Flush all buckets", "Upload all pending objects to the storage network immediately.", "Flush All", components.Cls("btn-primary", "btn-size-default"))
				</div>
			</form>
		}
		@components.CardSection("SSL Configuration") {
			<form @submit.prevent="saveSSLConfig()" class="p-4 space-y-4">
				@components.FormRow("SSL Mode", "ssl-mode", "Changing SSL mode requires a server restart.") {
					@components.Select(string(sslCfg.Mode), components.SelectOpts{
						Model: "ssl.mode",
						Extra: templ.Attributes{"id": "ssl-mode"},
						Options: []components.SelectOption{
							{Value: "none", Label: "None (HTTP only)"},
							{Value: "platform", Label: "Platform (PaaS/K8s handles TLS)"},
							{Value: "managed", Label: "Managed (built-in certificate management)"},
						},
					})
				}
				<div x-show="ssl.mode === 'managed'">
					@components.InputField(components.InputFieldOpts{
						Label:       "Email",
						ID:          "ssl-email",
						Hint:        "Used for certificate expiry notifications",
						Model:       "ssl.acme_email",
						Type:        "email",
						Placeholder: "admin@example.com",
						Extra:       templ.Attributes{":required": "ssl.mode === 'managed'"},
					})
				</div>
				<div x-show="ssl.mode === 'managed'">
					@components.InputField(components.InputFieldOpts{
						Label:       "Directory URL",
						ID:          "ssl-dir-url",
						Hint:        "Leave empty for default. Use staging URL for testing.",
						Model:       "ssl.acme_dir_url",
						Type:        "url",
						Placeholder: "https://acme-staging.example.org/directory",
					})
				</div>
				@components.SaveButton("sslSaving")
			</form>
		}
		@components.CardSection("Logging") {
			<form @submit.prevent="saveLogConfig()" class="p-4 space-y-4">
				@components.FormRow("Log Level", "log-level", "Controls verbosity. A backend restart is required to apply.") {
					@components.Select(logCfg.Level, components.SelectOpts{
						Model: "log.level",
						Extra: templ.Attributes{"id": "log-level"},
						Options: []components.SelectOption{
							{Value: "debug", Label: "Debug"},
							{Value: "info", Label: "Info"},
							{Value: "warn", Label: "Warn"},
							{Value: "error", Label: "Error"},
						},
					})
				}
				@components.FormRow("Log Format", "log-format", "JSON for structured logging, Human for readable console output.") {
					@components.Select(logCfg.Format, components.SelectOpts{
						Model: "log.format",
						Extra: templ.Attributes{"id": "log-format"},
						Options: []components.SelectOption{
							{Value: "json", Label: "JSON"},
							{Value: "human", Label: "Human"},
						},
					})
				}
				@components.SaveButton("logSaving")
			</form>
		}
		@components.CardSection("Software Updates") {
			<div
				class="p-4 space-y-4"
				x-data="updateControlsApp"
				x-init="init()"
			>
				<!-- Sidecar mode: full controls -->
				<template x-if="sidecarMode">
					<div class="space-y-4">
						<!-- Auto-update toggle -->
						<div class="flex items-center justify-between">
							<div>
								<div class="text-sm text-foreground font-body">Auto-update</div>
								<div class="meta-text">Automatically download and apply new versions when available.</div>
							</div>
							<label class="relative inline-flex items-center cursor-pointer">
								<input
									type="checkbox"
									class="sr-only peer"
									:checked="autoUpdateOn"
									@change="toggleAutoUpdate()"
									:disabled="toggleLoading"
								/>
								<div class="w-11 h-6 bg-muted peer-checked:bg-primary rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all"></div>
							</label>
						</div>
						<p x-show="toggleMsg" x-cloak class="text-sm font-body" :class="toggleErr ? 'text-destructive' : 'text-primary'" x-text="toggleMsg"></p>
						<!-- Manual update trigger -->
						<div class="border-t border-border pt-4 flex items-center justify-between">
							<div>
								<div class="text-sm text-foreground font-body">Manual update</div>
								<div class="meta-text">
									Triggers an immediate update check on the next sidecar poll cycle.
									<template x-if="lastDigest">
										<span>Current digest: <code class="text-xs text-muted-foreground" x-text="lastDigest.substring(0, 19) + '…'"></code></span>
									</template>
								</div>
							</div>
							<button
								type="button"
								class="btn-primary btn-size-default"
								:disabled="triggerLoading"
								@click="triggerUpdate()"
								x-text="triggerLoading ? 'Triggering…' : 'Update & Restart'"
							></button>
						</div>
						<p x-show="triggerMsg" x-cloak class="text-sm font-body" :class="triggerErr ? 'text-destructive' : 'text-primary'" x-text="triggerMsg"></p>
						<!-- Updater log -->
						<div x-show="updaterLog.length > 0" class="border-t border-border pt-4">
							<div class="text-sm text-foreground font-body mb-2">Updater log</div>
							<pre class="bg-muted/50 rounded p-3 text-xs text-muted-foreground font-mono overflow-x-auto max-h-48 overflow-y-auto">
								<template x-for="(line, i) in updaterLog" :key="i">
									<span x-text="line"></span>
								</template>
							</pre>
						</div>
					</div>
				</template>
				<!-- Badge mode: update available badge (no /state volume) -->
				<template x-if="!sidecarMode">
					<div class="space-y-3" x-data="versionCheckApp" x-init="init()">
						<div class="flex items-center justify-between">
							<div>
								<div class="text-sm text-foreground font-body">Software version</div>
								<div class="meta-text">Panel <code x-text="versionResult?.current_version || '...'"></code> · s3d <code>{ s3dVersion }</code></div>
							</div>
							<template x-if="versionLoading">
								<span class="form-hint">Checking…</span>
							</template>
							<template x-if="versionErr">
								<span class="form-hint">Unable to check</span>
							</template>
							<template x-if="!versionLoading && !versionErr && versionResult?.update_available">
								<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-body bg-amber-500/10 text-amber-500 border border-amber-500/20">
									<svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
										<path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"></path>
									</svg>
									Update available: <span x-text="versionResult?.latest_version"></span>
								</span>
							</template>
							<template x-if="!versionLoading && !versionErr && !versionResult?.update_available">
								<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-body bg-primary/10 text-primary border border-primary/20">
									<svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
										<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
									</svg>
									Up to date
								</span>
							</template>
						</div>
						<div class={ components.Cls("meta-text", "border-t border-border pt-3") }>
							Updates are managed by { platformName }. To enable in-panel updates, deploy with the update sidecar.
						</div>
					</div>
				</template>
			</div>
		}
		@components.CardSection("Admin Password") {
			<div
				class="p-4 space-y-4"
				x-data="changePasswordApp"
			>
				<div class="flex items-center justify-between">
					<div>
						<div class="text-sm text-foreground font-body">Change admin password</div>
						<div class="meta-text">Update the password used to sign in to the panel.</div>
					</div>
					<button type="button" class="btn-ghost btn-size-default" @click="showChangePw = !showChangePw" x-text="showChangePw ? 'Cancel' : 'Change'"></button>
				</div>
				<div x-show="showChangePw" x-cloak class="space-y-3 pt-2">
					@components.PasswordField("Current Password", "current-pw", "Current password", "current-password", templ.Attributes{"x-model": "currentPw"})
					@components.PasswordField("New Password", "new-pw", "New password", "new-password", templ.Attributes{"x-model": "newPw", "minlength": "8"})
					@components.PasswordField("Confirm New Password", "confirm-pw", "Confirm new password", "new-password", templ.Attributes{"x-model": "confirmPw", "minlength": "8"})
					@components.Button("Change Password", components.ButtonOpts{Type: "button", Class: components.Cls("btn-primary", "btn-size-default w-full"), OnClick: "changePassword()", LoadingProp: "loading", LoadingLabel: "Saving…", Disabled: "loading"})
				</div>
			</div>
		}
		@components.CardSectionDanger("Danger Zone") {
			<div
				class="p-4 space-y-4"
				x-data="restartApp"
				@dialog-confirm.window="$event.detail?.source === 'showRestart' && confirmRestart()"
			>
				<div class="flex items-center justify-between">
					<div>
						<div class="text-sm text-foreground font-body">Restart backend</div>
						<div class="meta-text">Stops and starts the S3 backend. Active uploads will fail.</div>
					</div>
					@components.Button("Restart", components.ButtonOpts{Type: "button", Class: components.Cls("btn-danger", "btn-size-default"), OnClick: "showRestart = true", LoadingProp: "restarting", LoadingLabel: "Restarting…", Disabled: "restarting"})
				</div>
				@components.Dialog("showRestart", "Restart backend", "This will stop and start the S3 backend. Any active uploads will fail.", "Restart", "btn-danger")
			</div>
		}
	</div>
}
